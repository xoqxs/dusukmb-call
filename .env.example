# Bu dosyayı .env olarak kopyala ve doldur:  cp .env.example .env

# Sunucunun genel IP'si (Oracle panelinde "Public IP")
PUBLIC_IP=1.2.3.4

# Sunucunun iç IP'si (Oracle panelinde "Private IP", genelde 10.0.0.x)
PRIVATE_IP=10.0.0.2

# Alan adın yoksa bedava: IP'deki noktaları tireye çevir + .sslip.io
DOMAIN=1-2-3-4.sslip.io

# Uzun rastgele bir şifre. Üretmek için:  openssl rand -hex 32
TURN_SECRET=buraya-uzun-rastgele-bir-sifre-yaz
